# ============================================
# MLOmics Project .gitignore
# ============================================

# ----- Agent -----
.agents/
.claude/
CLAUDE.md
PROJECT_SNAPSHOT.md

# ----- Data (raw & processed — too large for Git) -----
data/raw/
data/preprocessed/

# ----- Model artifacts -----
*.pkl
*.pt
*.pth
*.h5
*.hdf5
*.joblib
*.onnx
!app/model_artifacts/*.pkl
!app/model_artifacts/*.pt
# Block old un-suffixed legacy artifacts (replaced by _brca/_coad suffixed versions)
app/model_artifacts/config.json
app/model_artifacts/scaler.pkl
app/model_artifacts/xgb_best.pkl
app/model_artifacts/fusion_best.pt
app/model_artifacts/latent_space_data.json
app/model_artifacts/fusion_attributions.npz
app/model_artifacts/fusion_attribution_results.json

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ----- Jupyter Notebooks -----
.ipynb_checkpoints/

# ----- Environment -----
.env
.venv/
venv/
env/
*.env.local

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs & temp -----
*.log
*.tmp
*.temp

# ----- Dataset directory (original download, kept separate) -----
dataset/
content/

# ----- Generated demo sample inputs (backward-compat aliases) -----
# app/sample_input_brca.csv and app/sample_input_coad.csv are tracked.
# The un-suffixed alias is regenerated by scripts/prepare_demo_artifacts.py.
app/sample_input.csv

# ----- Streamlit runtime config (written by app for theme persistence) -----
.streamlit/config.toml

